MONGODB_URI=mongodb://localhost:27017
DATABASE_NAME=mercora

RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxx
RAZORPAY_KEY_SECRET=xxxxxxxxxxxxxxxxxxxx

LLM_API_KEY=
LLM_PROVIDER=none
# LLM_PROVIDER=gemini uses Google's Gemini API -- set LLM_API_KEY to a Gemini API key.
GEMINI_MODEL=gemini-2.5-flash
# LLM_PROVIDER=ollama uses a local model via Ollama (https://ollama.com) -- no API key,
# no external network calls. Run `ollama serve` and `ollama pull llama3.2` (or your model
# of choice) first, then set LLM_PROVIDER=ollama and optionally override the two lines below.
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2

JWT_SECRET=change-this-to-a-random-secret
JWT_ALGORITHM=HS256

FRONTEND_URL=http://localhost:5173
BACKEND_URL=http://localhost:8000
